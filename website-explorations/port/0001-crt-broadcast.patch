@@ -0,0 +1,33 @@
+"use client";
+
+import { useEffect } from "react";
+import { mount } from "@/lib/crt";
+
+// Shader settings for the site. These are the "Broadcast" numbers from the
+// explorations: flat tube, soft scanlines, a little bloom, a gentle vignette.
+const PARAMS = {
+  scanlineIntensity: 0.35,
+  bloomIntensity: 0.4,
+  rgbShift: 0.2,
+  curvature: 0,
+  vignetteStrength: 0.35,
+};
+
+export const TOGGLE_EVENT = "crt:toggle";
+
+/**
+ * Mounts the CRT treatment over #page. Renders nothing itself.
+ * Any element can flip the theme by dispatching `crt:toggle` on window.
+ */
+export default function CRT() {
+  useEffect(() => {
+    const crt = mount({ root: "#page", params: PARAMS });
+    const onToggle = () => crt.toggleTheme();
+    window.addEventListener(TOGGLE_EVENT, onToggle);
+    return () => {
+      window.removeEventListener(TOGGLE_EVENT, onToggle);
+      crt.destroy();
+    };
+  }, []);
+  return null;
+}
